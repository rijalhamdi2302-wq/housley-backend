PORT=4000
# MongoDB Atlas connection string (Database > Connect > Drivers)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/housely
# Any long random string — used to sign PIN-login session tokens
JWT_SECRET=change_this_to_something_long_and_random

# Groq AI API key (server-side only — the app never sees it)
# Get one at https://console.groq.com (free tier available)
GROQ_API_KEY=
